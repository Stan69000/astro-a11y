{
  "name": "@astro-a11y/astro-integration",
  "version": "0.2.2",
  "description": "Astro integration that scans every built page for accessibility issues, with RGAA 4.1.2 mapping.",
  "keywords": [
    "accessibility",
    "a11y",
    "rgaa",
    "wcag",
    "astro",
    "astro-integration",
    "withastro"
  ],
  "license": "MIT",
  "author": "Stan Bouchet",
  "homepage": "https://stan69000.github.io/astro-a11y/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stan69000/astro-a11y.git",
    "directory": "packages/astro-integration"
  },
  "bugs": {
    "url": "https://github.com/Stan69000/astro-a11y/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/copy-package.js src dist"
  },
  "dependencies": {
    "@astro-a11y/core": "workspace:*",
    "@astro-a11y/reporters": "workspace:*"
  },
  "peerDependencies": {
    "astro": ">=5"
  }
